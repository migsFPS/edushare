# =====================================================================
# EDUSHARE ENVIRONMENT CONFIGURATION TEMPLATE
# =====================================================================
# Copy this file to .env and configure your secrets.
# NEVER commit your actual .env file or credentials to Git.

# PORT & SERVER CONFIGURATION
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3000

# OFFICIAL GMAIL SMTP CONFIGURATION
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=edushare12@gmail.com
# Enter your 16-character Gmail App Password below (from Google Account -> Security -> 2-Step Verification -> App Passwords)
SMTP_PASS=
EMAIL_FROM=EduShare <edushare12@gmail.com>

# DATABASE CONFIGURATION
# Local development defaults to SQLite. Use a Neon Postgres URL on Vercel.
DATABASE_URL=./edushare.db
# Alternatively, Neon integrations may provide POSTGRES_URL.

# SESSION SECURITY
# Cryptographically secure secret key for session signing and authentication cookies (32+ characters)
SESSION_SECRET=

# AES-256-GCM ENCRYPTION KEY
# 32-byte (256-bit) hex string (64 hex characters) for AES-256-GCM backend encryption
AES_ENCRYPTION_KEY=
